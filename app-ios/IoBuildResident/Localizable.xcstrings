      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What it costs to run the shared areas: water tank, pumps, elevators and lighting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que cuesta mantener las áreas compartidas: cisterna, bombas, ascensores e iluminación."
          }
        }
      }
