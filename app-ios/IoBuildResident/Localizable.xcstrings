    "glossary_aliquot_def": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The percentage of the building that belongs to your apartment under Law No. 27157. It sets which part of the common expenses you pay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El porcentaje del edificio que le corresponde a tu departamento según la Ley N.° 27157. Define qué parte de los gastos comunes pagas."
          }
        }
      }
    },
    "glossary_common": {
