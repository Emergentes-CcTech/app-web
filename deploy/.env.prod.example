# IoBuild — variables de producción. Copiar a la raíz del proyecto como .env (no se versiona):
#   cp deploy/.env.prod.example .env && nano .env
# Generar cada secreto con:  openssl rand -base64 36 | tr -d '/+=' | cut -c1-40

# Dirección pública que entrega Tailscale Funnel (sin barra final)
PUBLIC_URL=https://iobuild.<tu-tailnet>.ts.net

# Puerto local donde escucha nginx (solo 127.0.0.1); Funnel apunta aquí
HTTP_PORT=8080

# Secretos obligatorios
JWT_SECRET=
DB_ROOT_PASSWORD=
DB_PASSWORD=
INFLUX_PASSWORD=
INFLUX_TOKEN=
DEVICE_INGEST_KEY=

# IA (opcional): sin clave se usan las explicaciones por reglas
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Pagos: en la demo se simulan. Para Stripe en modo prueba, claves sk_test/rk_test
STRIPE_USE_SIMULATED_PAYMENTS=true
STRIPE_SECRET_KEY=
STRIPE_RESTRICTED_API_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# Subida de recibos a Cloudinary (preset sin firma)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Simulador: un envío por minuto
SIMULATOR_INTERVAL_SECONDS=60

# Solo para la demo del detector estadístico (carga noches históricas). Dejar en false fuera de la demo
DEMO_ENABLED=false
