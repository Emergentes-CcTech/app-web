# Frontend environment variables — copy to .env and fill secrets
# All VITE_* vars are exposed to the client bundle at build time.

# Core API
VITE_API_URL=/api/v1
VITE_USERS_ENDPOINT_PATH=/users
VITE_IAM_SESSIONS_PATH=/sessions
VITE_PLANS_ENDPOINT_PATH=/plans
VITE_SUBSCRIPTIONS_ENDPOINT_PATH=/subscriptions
VITE_PROFILES_ENDPOINT_PATH=/profiles
VITE_UNITS_ENDPOINT_PATH=/units
VITE_DEVICES_ENDPOINT_PATH=/devices
VITE_CONDOMINIUMS_ENDPOINT_PATH=/condominiums
VITE_RESIDENTS_ENDPOINT_PATH=/residents
VITE_TELEMETRY_ENDPOINT_PATH=/readings
VITE_ALERTS_ENDPOINT_PATH=/alerts
VITE_BILLS_ENDPOINT_PATH=/utility_bills
VITE_SETTLEMENTS_ENDPOINT_PATH=/settlements
VITE_SETTLEMENT_LINES_ENDPOINT_PATH=/settlement_lines
VITE_PAYMENTS_ENDPOINT_PATH=/payments
VITE_AUDIT_ENDPOINT_PATH=/audit_events

# Dev proxy / app URL
# Backend real: http://localhost:5080 · Mock con json-server (npm run server): http://localhost:3000
VITE_PROXY_TARGET=http://localhost:5080
VITE_APP_URL=http://localhost:5173

# Third-party
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_WIDGET_URL=https://widget.cloudinary.com/v2.0/global/all.js
VITE_STRIPE_PUBLISHABLE_KEY=

# Polling de telemetría (RNF-012: lectura < 5 s)
VITE_POLLING_INTERVAL_MS=5000
